{
  "version": "0.27.0",
  "commit": "d99fa201b942f71271e0ca055fc6c2e425215441",
  "repository": "rmyndharis/OpenWA",
  "contract": {
    "webhookEvents": [
      "call.accepted",
      "call.missed",
      "call.received",
      "call.rejected",
      "event.response",
      "group.join",
      "group.join_request",
      "group.leave",
      "group.update",
      "message.ack",
      "message.edited",
      "message.failed",
      "message.reaction",
      "message.receipt",
      "message.received",
      "message.revoked",
      "message.sent",
      "poll.vote",
      "presence.update",
      "session.authenticated",
      "session.disconnected",
      "session.qr",
      "session.reconnect_loop",
      "session.restriction",
      "session.status",
      "status.received"
    ],
    "messageListPath": "sessions/:sessionId/messages",
    "messageListQueries": [
      "after",
      "chatId",
      "direction",
      "from",
      "inlineMedia",
      "limit",
      "messageId",
      "offset",
      "orderBy",
      "since",
      "type",
      "until"
    ],
    "idempotentSendPaths": [
      "forward",
      "reply",
      "send-audio",
      "send-contact",
      "send-document",
      "send-image",
      "send-location",
      "send-poll",
      "send-sticker",
      "send-template",
      "send-text",
      "send-video"
    ],
    "groupMemberLabel": {
      "method": "PUT",
      "path": "sessions/:sessionId/groups/:groupId/member-label",
      "role": "ApiKeyRole.OPERATOR",
      "fields": {
        "label": {
          "IsString": [],
          "Matches": ["^[\\s\\S]{0,30}$", ""]
        }
      }
    },
    "customLinkPreview": {
      "url": { "IsString": [], "IsNotEmpty": [], "MaxLength": [2048] },
      "title": { "IsString": [], "IsNotEmpty": [], "MaxLength": [256] },
      "description": { "IsOptional": [], "IsString": [], "MaxLength": [1024] },
      "thumbnailUrl": { "IsOptional": [], "IsMediaUrl": [] },
      "thumbnailBase64": { "IsOptional": [], "IsString": [] }
    },
    "search": {
      "method": "GET",
      "path": "search",
      "role": "ApiKeyRole.OPERATOR",
      "queries": ["chatId", "dateFrom", "dateTo", "direction", "from", "limit", "match", "offset", "q", "sessionId", "type"],
      "fields": {
        "q": { "IsString": [], "IsNotEmpty": [], "MaxLength": [1000], "NoNulCharacter": [] },
        "match": { "IsOptional": [], "IsIn": [["word", "contains"]] }
      }
    },
    "redrive": {
      "method": "POST",
      "path": "webhooks/delivery-failures/redrive",
      "role": "ApiKeyRole.ADMIN",
      "fields": {
        "sessionId": { "IsOptional": [], "IsString": [], "MaxLength": [128] },
        "webhookId": { "IsOptional": [], "IsString": [], "MaxLength": [128] },
        "ids": {
          "IsOptional": [],
          "IsArray": [],
          "ArrayMaxSize": [500],
          "IsString": [{ "each": true }],
          "MaxLength": [128, { "each": true }]
        },
        "limit": { "IsOptional": [], "IsInt": [], "Min": [1], "Max": [500] }
      }
    }
  }
}
